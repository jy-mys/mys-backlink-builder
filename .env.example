# Public URL of the app, no trailing slash. The OAuth redirect URI is APP_ORIGIN/auth/callback.
APP_ORIGIN=http://localhost:8080
PORT=8080

# The "Backlink Tracker" spreadsheet. Must match the ID embedded in public/index.html,
# or the server refuses to start.
SHEET_ID=1KcJjTGJpxOQVsfkdMFpZ6sIfEWGWtMj0kcm8eWyLkZ0

# Google sign-in, identity only (openid email profile). OAuth client type: Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the session cookie. 32+ random characters: openssl rand -base64 48
SESSION_SECRET=

# Sheets access is the app's service account. On Cloud Run leave this unset: the attached
# service account is used via the metadata server. Outside Cloud Run, point it at a JSON
# key file kept outside the repo (not possible in the company project: key creation is blocked).
GOOGLE_APPLICATION_CREDENTIALS=

# Who may sign in. Comma-separated; set either or both.
ALLOWED_DOMAINS=mysense.com.my
ALLOWED_EMAILS=

# Optional. Without it, the Check panel falls back to the Google links.
FIRECRAWL_API_KEY=
SEARCHES_PER_HOUR=30
